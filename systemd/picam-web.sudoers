# The Picam-web service may reboot the Pi (the only way to power-cycle a sensor that stopped
# answering, and to load another camera model), from the web UI or automatically when that is
# enabled, and change the camera sensor overlay in config.txt with its root-owned helper.
# Nothing else.
@VIEWER_USER@ ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
@VIEWER_USER@ ALL=(root) NOPASSWD: /usr/local/sbin/picam-camera-overlay
