[Unit]
Description=Picam-web camera viewer and API
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=@VIEWER_USER@
ExecStart=/usr/bin/python3 @VIEWER_DIR@/picam_web/server.py --port 80
# Port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# The service pings systemd every 15 s while its camera lock is free; a hung camera call
# (no ping for 30 s) makes systemd restart it
WatchdogSec=30
TimeoutStartSec=90
# Exit code 3 = restart requested (tuning file switch, camera reopen)
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
